    "/api/ventas": {
      "post": {
        "tags": [
          "Ventas"
        ],
        "summary": "Registrar una venta y descontar inventario en tiempo real",
        "description": "Operación transaccional: valida stock disponible, registra la venta y sus detalles, y descuenta el inventario de forma atómica. Si el stock no alcanza, la venta no se registra.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "producto_id": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "example": 1
                        },
                        "cantidad": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "example": 2
                        }
                      },
                      "required": [
                        "producto_id",
                        "cantidad"
                      ]
                    },
                    "minItems": 1,
                    "description": "Detalle de la venta (al menos un ítem)"
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Venta registrada y stock actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 0,
                      "exclusiveMinimum": true,
                      "example": 1
                    },
                    "total": {
                      "type": "number",
                      "minimum": 0,
                      "example": 10999.98
                    },
                    "created_at": {
                      "type": "string",
                      "example": "2026-01-01T12:00:00.000Z"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "producto_id": {
                            "type": "integer",
                            "minimum": 0,
                            "exclusiveMinimum": true,
                            "example": 1
                          },
                          "cantidad": {
                            "type": "integer",
                            "minimum": 0,
                            "exclusiveMinimum": true,
                            "example": 2
                          },
                          "precio_unitario": {
                            "type": "number",
                            "minimum": 0,
                            "example": 5499.99
                          }
                        },
                        "required": [
                          "producto_id",
                          "cantidad",
                          "precio_unitario"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "total",
                    "created_at",
                    "items"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Stock insuficiente o cantidad inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "STOCK_INSUFICIENTE"
