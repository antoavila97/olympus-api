                      "precio": {
                        "type": "number",
                        "minimum": 0,
                        "example": 5499.99
                      },
                      "stock": {
                        "type": "integer",
                        "minimum": 0,
                        "example": 20
                      },
                      "created_at": {
                        "type": "string",
                        "example": "2026-01-01T12:00:00.000Z"
                      },
                      "updated_at": {
                        "type": "string",
                        "example": "2026-01-01T12:00:00.000Z"
                      }
                    },
                    "required": [
                      "id",
                      "nombre",
                      "descripcion",
                      "precio",
                      "stock",
                      "created_at",
                      "updated_at"
                    ]
                  }
                }
              }
            }
          },
          "500": {
