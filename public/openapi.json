            "description": "Catálogo completo devuelto en JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": 0,
                        "exclusiveMinimum": true,
                        "example": 1
                      },
                      "nombre": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "example": "Smart TV 50\" 4K"
                      },
                      "descripcion": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 500,
                        "example": "Televisor LED 4K UltraHD con HDR"
